# Copy this file to .env and fill in your keys. Never commit .env.

# AI provider. Only "gemini" is wired up for now.
LLM_PROVIDER=gemini

# Required — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the default Gemini models
# GEMINI_SPECIALIST_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemini-3.8-flash
# GEMINI_MAX_CONCURRENT=2

# Optional — Reddit app (https://www.reddit.com/prefs/apps, type "script").
# Without these, Reddit blocks requests and the Social agent gets no posts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=equitylens-prototype/0.1

# News comes from Google News RSS — no key needed.

# Bull vs bear debate: 2 = opening cases + rebuttals (4 AI calls), 1 = opening only (2 calls)
# DEBATE_ROUNDS=2
